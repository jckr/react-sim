{
  "name": "react-sim-engine",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/engine.ts src/sim.ts src/worker/workerRunner.ts src/worker/createSimWorker.ts src/worker/protocol.ts src/worker/serialize.ts --format esm,cjs --dts --clean",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js",
      "require": "./dist/engine.cjs"
    },
    "./sim": {
      "types": "./dist/sim.d.ts",
      "import": "./dist/sim.js",
      "require": "./dist/sim.cjs"
    },
    "./worker/runner": {
      "types": "./dist/worker/workerRunner.d.ts",
      "import": "./dist/worker/workerRunner.js",
      "require": "./dist/worker/workerRunner.cjs"
    },
    "./worker/create": {
      "types": "./dist/worker/createSimWorker.d.ts",
      "import": "./dist/worker/createSimWorker.js",
      "require": "./dist/worker/createSimWorker.cjs"
    },
    "./worker/protocol": {
      "types": "./dist/worker/protocol.d.ts",
      "import": "./dist/worker/protocol.js",
      "require": "./dist/worker/protocol.cjs"
    }
  }
}
